{
  "name": "argo",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "PORT=3001 tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsx --test src/*.test.ts src/tools/*.test.ts",
    "eval": "node scripts/eval/probe.mjs",
    "eval:e2e": "node scripts/eval/e2e.mjs",
    "eval:hermes": "node scripts/eval/hermes.mjs",
    "eval:judge": "node scripts/eval/quality-judge.mjs",
    "eval:supervisor": "node scripts/eval/supervisor/run.mjs",
    "eval:trend": "node scripts/eval/trend.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-html-parser": "^6.1.13",
    "ollama": "^0.5.9",
    "tsc": "^2.0.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.15.7",
    "typescript": "^5.5.3"
  }
}
